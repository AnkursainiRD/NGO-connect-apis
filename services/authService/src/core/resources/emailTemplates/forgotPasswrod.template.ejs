<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NGO Connect - Reset Password</title>
</head>
<body style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif; margin: 0; padding: 0; background-color: #f7f9fc;">

    <div style="width: 100%; padding: 40px 0;">

        <table align="center" border="0" cellpadding="0" cellspacing="0" width="100%" style="max-width: 540px; background-color: #ffffff; border-radius: 12px; overflow: hidden; box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);">

            <tr>
                <td align="center" style="padding: 30px 25px 10px 25px; background-color: #ffffff;">
                    <img src="<%= logoUrl || '[NGO Connect Logo URL]' %>" alt="NGO Connect" width="140" style="display: block; border: 0; max-width: 140px; height: auto;">
                </td>
            </tr>
            
            <tr>
                <td style="padding: 20px 35px 30px 35px;">
                    <h1 style="color: #334455; font-size: 24px; font-weight: 700; text-align: center; margin: 0 0 15px 0;">
                        Secure Password Reset
                    </h1>

                    <p style="color: #556677; font-size: 16px; line-height: 1.6; margin-bottom: 25px; text-align: center;">
                        Hello **<%= userName %>**, we received a request to change your password.
                    </p>

                    <div style="text-align: center; margin: 30px 0;">
                        
                        <table border="0" cellpadding="0" cellspacing="0" align="center">
                            <tr>
                                <td align="center" style="border-radius: 8px; background-color: #1abc9c; padding: 15px 30px; box-shadow: 0 4px 15px rgba(26, 188, 156, 0.4);">
                                    <a href="<%= resetLink %>" target="_blank" style="font-size: 17px; font-weight: bold; color: #ffffff; text-decoration: none; display: inline-block;">
                                        Set New Password
                                    </a>
                                </td>
                            </tr>
                        </table>
                        
                        <p style="color: #8899aa; font-size: 13px; margin-top: 20px; margin-bottom: 0;">
                            This link is valid for **<%= expiryTime %>**.
                        </p>
                    </div>

                    <p style="color: #778899; font-size: 15px; line-height: 1.6; margin-top: 30px; margin-bottom: 0; padding: 15px; background-color: #f0f3f6; border-left: 4px solid #f39c12; border-radius: 4px;">
                        <strong style="color: #334455;">If you did not request this,</strong> please ignore this email. Your current password will remain secure.
                    </p>
                </td>
            </tr>

            <tr>
                <td style="padding: 35px 35px 40px 35px; text-align: center;">
                    <p style="color: #aab8c2; font-size: 14px; line-height: 1.5; margin-bottom: 20px;">
                        Thank you for your dedication to the community.
                        <br>
                        The NGO Connect Team
                    </p>
                    
                    <p style="color: #aab8c2; font-size: 12px; margin: 0;">
                        <a href="<%= supportLink %>" style="color: #1abc9c; text-decoration: none; margin: 0 10px;">Help Center</a>
                        &nbsp; &bull; &nbsp;
                        <a href="<%= websiteLink %>" style="color: #1abc9c; text-decoration: none; margin: 0 10px;">NGO Connect Website</a>
                    </p>
                </td>
            </tr>
        </table>
    </div>
</body>
</html>